# ============================================================================
# Configuration Supabase (mode « cerveau partagé »)
# ----------------------------------------------------------------------------
# Copiez ce fichier en `.env` (ou `.env.local`) et renseignez les 2 variables.
#
# SI LES DEUX SONT DÉFINIES  -> l'application utilise Supabase (base + Auth + RLS).
# SI L'UNE EST ABSENTE       -> l'application reste en MODE LOCAL (démo localStorage).
#
# La clé « anon » est PUBLIQUE par conception : la sécurité est assurée par les
# policies RLS côté base (voir supabase/rls.sql), jamais par le client.
# Récupération : Dashboard Supabase > Project Settings > API.
# ============================================================================

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
