# ---------------------------------------------------------------------------
# Deux sites sur la même adresse :
#   • /rh  → l'application RH (fichiers statiques construits par Vite) ;
#   • /    → le site vitrine, préparé séparément.
#
# La racine appartient au SITE : c'est elle que verra un visiteur et qui portera
# le futur nom de domaine. L'application vit sous un préfixe.
# ---------------------------------------------------------------------------
:80 {
	encode gzip

	# Sans cette redirection, « /rh » tout court (sans barre finale) ne
	# correspondrait à aucune règle et renverrait une erreur — or c'est
	# exactement l'adresse que les gens tapent.
	redir /rh /rh/

	# `handle_path` RETIRE le préfixe avant de chercher le fichier : /rh/assets/x.js
	# est servi depuis /srv/assets/x.js. Un simple `handle` ne le retirerait pas,
	# et toutes les ressources tomberaient à côté.
	handle_path /rh/* {
		root * /srv

		# Les RESSOURCES sont servies sans repli : sinon un fichier manquant
		# renverrait index.html avec un code 200, et le navigateur échouerait sur
		# « du HTML reçu à la place d'un script » — un symptôme qui n'oriente pas
		# du tout vers la vraie cause (un chemin de déploiement cassé).
		@ressource path /assets/*
		handle @ressource {
			file_server
		}

		# Repli SPA pour les PAGES : toute URL inconnue renvoie index.html, pour
		# que le routage React fonctionne au rechargement d'une page profonde
		# (/rh/presences).
		handle {
			try_files {path} /index.html
			file_server
		}
	}

	# ------------------------------------------------------------------ site --
	# La racine appartient au SITE VITRINE, dont la configuration vit dans SON
	# dépôt. Ce fichier-ci est recopié à chaque déploiement de l'application RH :
	# tant que leur bloc y figurait, notre prochain `git push` l'écrasait et le
	# site tombait sans prévenir. Chacun est désormais maître de son bloc.
	#
	# Leur fichier est déposé dans /opt/site-marchais, monté sur /srv-site dans
	# ce conteneur — d'où ce chemin.
	#
	# Import par MOTIF et non par nom exact, et ce n'est pas un détail : un
	# import littéral dont le fichier manque fait REFUSER toute la configuration
	# à Caddy. Un faux pas dans LEUR déploiement ferait alors tomber NOTRE
	# application en même temps que leur site. Avec un motif, Caddy passe outre :
	# la racine retombe sur la page d'attente ci-dessous, l'application continue.
	import /srv-site/deploy/caddy-*.conf

	# `handle_errors` se place au niveau du SITE, jamais dans un `handle` : Caddy
	# refuse de démarrer sinon (« is not an ordered HTTP handler »).
	handle_errors {
		# Page d'attente UNIQUEMENT pour une NAVIGATION hors application.
		#
		# La condition sur `Accept` n'est pas un détail : sans elle, /sw.js
		# recevait cette page avec un code 200. Or le navigateur d'un visiteur
		# ayant connu l'application à la racine y cherche encore son service
		# worker — et ne le désenregistre QUE s'il obtient une vraie erreur. Avec
		# un 200, l'ancienne version resterait indéfiniment servie par-dessus le
		# futur site.
		@hors_appli {
			not path /rh/*
			header Accept *text/html*
		}
		respond @hors_appli `<!doctype html><html lang="fr"><meta charset="utf-8"><title>ETS Marchais</title><meta name="viewport" content="width=device-width,initial-scale=1"><style>body{font-family:system-ui,sans-serif;display:grid;place-items:center;min-height:100vh;margin:0;background:#F7F8FB;color:#1B2540;text-align:center}a{color:#17356C}</style><div><h1>ETS Marchais</h1><p>Le site est en cours de préparation.</p><p><a href="/rh/">Accéder à l'application RH</a></p></div>` 200
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}
}
